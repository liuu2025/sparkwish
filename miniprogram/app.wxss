page {
  --surface-card: #272131;
  --surface-border: #493d59;
  --shadow-card: inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 6rpx 12rpx rgba(0, 0, 0, 0.2),
    0 20rpx 40rpx rgba(0, 0, 0, 0.3);
  --shadow-pressed: inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 3rpx 8rpx rgba(0, 0, 0, 0.24);
  background: #15121e;
  color: #f2edf9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 64rpx;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 12rpx 4rpx 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-title::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #a78bfa;
}

.section-hint {
  font-size: 24rpx;
  color: #a49ab5;
}

.nav-chevron {
  display: inline-block;
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  border: solid currentColor;
  border-width: 0 3rpx 3rpx 0;
  color: #b6a3cf;
  transform: rotate(-45deg);
  pointer-events: none;
}

.scene-card--pressed .nav-chevron,
.teaser--pressed .nav-chevron,
.result-teaser--pressed .nav-chevron,
.catalog-action--pressed .nav-chevron {
  color: #dfd2f7;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #7950dc;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.12),
    0 6rpx 12rpx rgba(0, 0, 0, 0.2),
    0 12rpx 24rpx rgba(91, 52, 170, 0.24);
  transition: box-shadow 0.18s ease, transform 0.18s ease,
    filter 0.18s ease;
}

.btn-primary--pressed {
  background: #6840c4;
  box-shadow: var(--shadow-pressed);
  transform: translateY(2rpx);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  border: 1rpx solid var(--surface-border);
  color: #cfc6e2;
  font-size: 28rpx;
  background: #2b2338;
  box-shadow: var(--shadow-pressed);
  transition: background-color 0.18s ease, transform 0.18s ease;
}

.btn-ghost--pressed {
  background: #2d2440;
  transform: translateY(2rpx);
}

.footnote {
  margin-top: 28rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a49ab5;
  text-align: center;
}

.state-box {
  padding: 44rpx 30rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 24rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ece7f7;
}

.state-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #b3a8c5;
}

.state-action {
  margin-top: 26rpx;
}

.btn-copy {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 64rpx;
  padding: 0 30rpx;
  border: 1rpx solid #4a3d63;
  border-radius: 999rpx;
  color: #b9a8ff;
  font-size: 24rpx;
  line-height: 1;
  background: #332842;
  box-shadow: var(--shadow-pressed);
  transition: background-color 0.18s ease, transform 0.18s ease;
}

.btn-copy--pressed {
  background: #2d2440;
  transform: translateY(1rpx);
}

.btn-copy[disabled] {
  border-color: #362d47;
  color: #6a6183;
}

.btn-primary[disabled],
.btn-ghost[disabled] {
  background: #2e2540;
  color: #8d819f;
  box-shadow: none;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .page .btn-primary,
  .page .btn-ghost,
  .page .btn-copy,
  .page .scene-card,
  .page .teaser,
  .page .result-teaser,
  .page .order-item,
  .page .catalog-action,
  .page .chip,
  .page .option {
    transition: none;
    transform: none;
  }
}
