.home {
  display: flex;
  flex-direction: column;
  padding-top: 16rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 44rpx;
  padding: 72rpx 36rpx 80rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #8b5cf6 0%, #6d3ef0 55%, #4c1fa8 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(124, 77, 242, 0.4);
}

.hero::after {
  content: "";
  position: absolute;
  top: -70rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.hero::before {
  content: "";
  position: absolute;
  bottom: -90rpx;
  left: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196, 181, 253, 0.3), rgba(196, 181, 253, 0));
  pointer-events: none;
}

.hero-mark {
  display: none;
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 1rpx;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.scene-card {
  position: relative;
  width: calc(50% - 24rpx);
  min-height: 160rpx;
  box-sizing: border-box;
  margin: 12rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid #332a44;
  border-radius: 30rpx;
  background: #211a2d;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.32);
  transition: transform 0.18s ease, box-shadow 0.18s ease,
    background-color 0.18s ease;
}

.scene-card--pressed {
  background: #292136;
  transform: scale(0.985);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.28);
}

.scene-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ece7f7;
}

.scene-desc {
  margin-top: 8rpx;
  padding-right: 56rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9c92b4;
}

.scene-arrow {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  color: #857a9e;
  font-size: 26rpx;
  line-height: 1;
}

.teaser {
  position: relative;
  overflow: hidden;
  margin-top: 48rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #3a2d55;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #241b36 0%, #2a1f42 100%);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.3);
}

.teaser::after {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(154, 108, 255, 0.22), rgba(154, 108, 255, 0));
  pointer-events: none;
}

.teaser--pressed {
  background: #2e2344;
}

.teaser-arrow {
  position: absolute;
  top: 50%;
  right: 26rpx;
  transform: translateY(-50%);
  color: #857a9e;
  font-size: 28rpx;
}

.teaser-title {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  font-weight: 700;
}

.version {
  margin-top: auto;
  padding-top: 48rpx;
  font-size: 26rpx;
  color: #857a9e;
  text-align: center;
}
