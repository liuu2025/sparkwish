.home {
  display: flex;
  flex-direction: column;
  padding-top: 16rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 44rpx;
  padding: 58rpx 34rpx 60rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 34rpx;
  background: #7545d6;
  color: #ffffff;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.12),
    0 8rpx 16rpx rgba(0, 0, 0, 0.2),
    0 22rpx 44rpx rgba(0, 0, 0, 0.32);
}

.hero-mark {
  display: none;
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 1rpx;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.scene-card {
  position: relative;
  width: calc(50% - 24rpx);
  min-height: 160rpx;
  box-sizing: border-box;
  margin: 12rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 30rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease, box-shadow 0.18s ease,
    background-color 0.18s ease;
}

.scene-card--pressed {
  background: #30273e;
  transform: translateY(3rpx) scale(0.99);
  box-shadow: var(--shadow-pressed);
}

.scene-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scene-name {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ece7f7;
}

.scene-desc {
  margin-top: 8rpx;
  min-height: 3.2em;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b3a8c5;
}

.scene-arrow {
  margin-right: 4rpx;
  margin-left: 12rpx;
}

.teaser {
  position: relative;
  overflow: hidden;
  margin-top: 48rpx;
  padding: 28rpx 92rpx 28rpx 30rpx;
  border: 1rpx solid #58436f;
  border-radius: 26rpx;
  background: #30243f;
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease, box-shadow 0.18s ease,
    background-color 0.18s ease;
}

.teaser--pressed {
  background: #392b4b;
  transform: translateY(3rpx);
  box-shadow: var(--shadow-pressed);
}

.teaser-arrow {
  position: absolute;
  top: 50%;
  right: 32rpx;
  margin-top: -7rpx;
}

.teaser-title {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  font-weight: 700;
}

.teaser-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #b3a8c5;
}

.version {
  margin-top: auto;
  padding-top: 48rpx;
  font-size: 26rpx;
  color: #a49ab5;
  text-align: center;
}
