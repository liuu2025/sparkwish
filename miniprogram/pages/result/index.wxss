.result {
  padding-top: 20rpx;
}

.result-head {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 32rpx 30rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 28rpx;
  background: #30243f;
  box-shadow: var(--shadow-card);
}

.result-kicker {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(139, 92, 246, 0.2);
  color: #b9a8ff;
  font-size: 22rpx;
  font-weight: 600;
}

.result-title {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.result-sub {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: #b3a8c5;
  font-size: 24rpx;
  line-height: 1.7;
}

.result-card {
  margin-bottom: 30rpx;
  padding: 30rpx 30rpx 26rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 28rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
}

.result-top {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.result-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: rgba(139, 92, 246, 0.2);
  color: #b9a8ff;
  font-size: 24rpx;
  font-weight: 700;
}

.result-label {
  color: #a49ab5;
  font-size: 21rpx;
}

.result-text {
  display: block;
  color: #ece7f7;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 31rpx;
  line-height: 1.95;
  text-align: justify;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.result-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
}

.result-empty {
  padding: 50rpx 30rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 24rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.result-empty-title {
  font-size: 30rpx;
  font-weight: 600;
}

.result-empty-text {
  margin-top: 10rpx;
  color: #b3a8c5;
  font-size: 24rpx;
}

.result-tools {
  margin-top: 34rpx;
}

.result-back {
  margin-top: 18rpx;
}

.result-teaser {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #58436f;
  border-radius: 24rpx;
  background: #30243f;
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease, box-shadow 0.18s ease,
    background-color 0.18s ease;
}

.result-teaser-copy {
  flex: 1;
}

.result-teaser-title {
  color: #f2edf9;
  font-size: 28rpx;
  font-weight: 600;
}

.result-teaser-text {
  margin-top: 6rpx;
  color: #b3a8c5;
  font-size: 23rpx;
  line-height: 1.7;
}

.result-teaser--pressed {
  background: #392b4b;
  transform: translateY(3rpx);
  box-shadow: var(--shadow-pressed);
}

.result-teaser-arrow {
  margin-right: 6rpx;
  margin-left: 24rpx;
}
