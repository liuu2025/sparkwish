.create {
  padding-bottom: 230rpx;
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
}

.scene-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 28rpx;
  background: #30243f;
  box-shadow: var(--shadow-card);
}

.scene-hero-badge {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #7950dc;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.12),
    0 6rpx 14rpx rgba(0, 0, 0, 0.24);
}

.scene-hero-text {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.scene-hero-name {
  font-size: 38rpx;
  font-weight: 700;
}

.scene-hero-desc {
  margin-top: 6rpx;
  color: #b3a8c5;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-card {
  padding: 8rpx 28rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 28rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
}

.field {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #2e2540;
}

.field--last {
  border-bottom: none;
}

.field-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.field-label {
  font-size: 29rpx;
  font-weight: 600;
  color: #ece7f7;
}

.field-optional {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #2c2440;
  color: #b3a8c5;
  font-size: 20rpx;
}

.field-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #a49ab5;
}

.text-input {
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 18rpx;
  background: #211b2c;
  font-size: 30rpx;
  color: #ece7f7;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.chip {
  margin: 6rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  background: #2a2138;
  color: #b3a9c9;
  font-size: 26rpx;
  line-height: 1.3;
  transition: background-color 0.18s ease, border-color 0.18s ease,
    color 0.18s ease, transform 0.18s ease;
}

.chip--pressed {
  background: #332a47;
  transform: scale(0.96);
}

.chip--active {
  border-color: #8b5cf6;
  background: #42305b;
  color: #c4b5fd;
  font-weight: 600;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.option {
  position: relative;
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  margin: 6rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: #2a2138;
  transition: background-color 0.18s ease, border-color 0.18s ease,
    transform 0.18s ease;
}

.option--pressed {
  background: #332a47;
  transform: scale(0.98);
}

.option--active {
  border-color: #8b5cf6;
  background: #42305b;
}

.option--active::after {
  content: "✓";
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #7950dc;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(124, 77, 242, 0.4);
}

.option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ece7f7;
  transition: color 0.18s ease;
}

.option--active .option-name {
  color: #c4b5fd;
}

.option-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a49ab5;
}

.option-grid--three .option {
  width: calc(33.33% - 12rpx);
  padding: 18rpx 12rpx;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 32rpx 18rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #2e2540;
  background: #1d1828;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.36);
}

.bottom-note {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #a49ab5;
  text-align: center;
}

@media (max-width: 340px) {
  .option-desc {
    font-size: 19rpx;
  }
}
