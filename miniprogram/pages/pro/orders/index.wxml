<view class="page orders">
  <view class="orders-head">
    <view class="orders-title">我的订单</view>
  </view>

  <view class="state-box" wx:if="{{!ordersReady}}">
    <view class="state-title">订单服务暂未接入</view>
    <view class="state-text">接入完成后，可在此查看已购买的套餐。</view>
  </view>

  <view class="state-box" wx:elif="{{loading}}">
    <view class="state-text">正在获取订单…</view>
  </view>

  <view class="state-box" wx:elif="{{failed}}">
    <view class="state-title">订单暂时无法获取</view>
    <view class="state-text">{{errorText}}</view>
    <button class="btn-ghost state-action" hover-class="btn-ghost--pressed" bindtap="onRetry">重新获取</button>
  </view>

  <view class="state-box" wx:elif="{{!orders.length}}">
    <view class="state-title">暂无已支付订单</view>
    <view class="state-text">已支付的订单会显示在这里。</view>
  </view>

  <block wx:else>
    <view
      class="order-item"
      wx:for="{{orders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      hover-class="order-item--pressed"
      aria-role="button"
      aria-label="查看订单详情"
    >
      <view class="order-item-top">
        <text class="order-item-name">{{item.name}}</text>
        <text class="order-item-status status-{{item.tone}}">{{item.statusTitle}}</text>
      </view>
      <view class="order-item-meta">{{item.createdText}} · ¥{{item.price}}</view>
    </view>
  </block>

  <view class="orders-foot">
    <view class="orders-link" hover-class="orders-link--pressed" bindtap="onRetry" wx:if="{{ordersReady}}">刷新订单</view>
  </view>
</view>
