.pro {
  padding-top: 20rpx;
}

.catalog-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.catalog-action {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 22rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
  color: #ded4ee;
  font-size: 26rpx;
  line-height: 1.4;
  transition: transform 0.18s ease, box-shadow 0.18s ease,
    background-color 0.18s ease;
}

.catalog-action--pressed {
  background: #352a45;
  transform: translateY(3rpx);
  box-shadow: var(--shadow-pressed);
}

.catalog-action-arrow {
  margin-left: 20rpx;
}

.catalog-refresh {
  margin-left: 16rpx;
  color: #c4aff4;
}

.catalog-refresh-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

.catalog-action[disabled] {
  color: #9c8eaf;
  background: #241e2e;
  box-shadow: var(--shadow-pressed);
  transform: none;
}

.plan-card {
  margin-bottom: 30rpx;
  padding: 30rpx 28rpx 26rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 26rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
}

.plan-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.plan-name {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
}

.plan-price {
  flex-shrink: 0;
  color: #b9a8ff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.plan-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #b3a8c5;
}

.plan-btn {
  margin-top: 26rpx;
}

.plan-btn[disabled] {
  background: #2e2540;
  color: #6a6183;
  box-shadow: none;
}

.plan-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a49ab5;
  text-align: center;
}

.confirm-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: rgba(10, 7, 16, 0.72);
}

.confirm-dialog {
  width: 100%;
  max-width: 560rpx;
  padding: 40rpx 36rpx 32rpx;
  border: 1rpx solid #3a3050;
  border-radius: 28rpx;
  background: #211a2d;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.5);
}

.confirm-title {
  color: #ece7f7;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
}

.confirm-body {
  margin-top: 30rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #191422;
}

.confirm-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.confirm-row + .confirm-row {
  margin-top: 16rpx;
}

.confirm-label {
  color: #a49ab5;
  font-size: 26rpx;
}

.confirm-value {
  color: #ece7f7;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}

.confirm-price {
  color: #b9a8ff;
  font-size: 32rpx;
  font-weight: 700;
}

.confirm-tip {
  margin-top: 22rpx;
  color: #b3a8c5;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.confirm-actions {
  display: flex;
  gap: 22rpx;
  margin-top: 32rpx;
}

.confirm-cancel {
  flex: 1;
  margin: 0;
}

.confirm-ok {
  flex: 1.4;
  margin: 0;
}
