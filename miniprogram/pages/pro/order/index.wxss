.order {
  padding-top: 20rpx;
}

.status-bar {
  margin-bottom: 26rpx;
  padding: 28rpx 26rpx;
  border-radius: 24rpx;
  background: #30243f;
  border: 1rpx solid var(--surface-border);
  box-shadow: var(--shadow-card);
}

.status-title {
  font-size: 32rpx;
  font-weight: 700;
}

.status-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #b3a8c5;
}

.status-wait .status-title {
  color: #ffd54f;
}

.status-delivering .status-title {
  color: #b9a8ff;
}

.status-done .status-title {
  color: #81c784;
}

.status-closed .status-title {
  color: #b3a8c5;
}

.status-unknown .status-title {
  color: #b3a8c5;
}

.section {
  margin-bottom: 30rpx;
  padding: 26rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 24rpx;
  background: var(--surface-card);
  box-shadow: var(--shadow-card);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ece7f7;
}

.kv {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
}

.kv-label {
  flex-shrink: 0;
  width: 140rpx;
  color: #a49ab5;
  font-size: 23rpx;
}

.kv-value {
  flex: 1;
  color: #cfc6e2;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.blessing-text {
  display: block;
  margin-top: 18rpx;
  color: #ece7f7;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1.95;
  text-align: justify;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.placeholder {
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #2a2138;
  color: #a49ab5;
  font-size: 23rpx;
  line-height: 1.7;
}

.order-actions {
  margin-top: 10rpx;
}

.order-refresh {
  margin-top: 18rpx;
}

.order-pay-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a49ab5;
  text-align: center;
}

.order-back {
  margin-top: 30rpx;
  padding: 20rpx;
  color: #b9a8ff;
  font-size: 24rpx;
  text-align: center;
}

.order-back--pressed {
  background: #2a2138;
}
